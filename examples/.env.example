# Sample environment for the EnvVault examples.
# Import with: envvault import .env

DATABASE_URL=postgres://user:password@localhost:5432/app
REDIS_URL=redis://localhost:6379
SECRET_KEY="change-me-in-production"
PUBLIC_API_URL=https://api.example.com
# Never give this to the frontend service (see .envvault.json).
OPENAI_API_KEY=sk-example-replace-me
