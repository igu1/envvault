{
  "name": "envvault-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Electron frontend for the EnvVault CLI: local vault and remote server control",
  "main": "main.cjs",
  "scripts": {
    "prestart": "npm --prefix .. run build",
    "start": "electron .",
    "test": "npm --prefix .. run build && node --test *.test.cjs",
    "dist": "npm --prefix .. run build && electron-builder --publish never",
    "e2e": "node --test e2e/desktop-flow.e2e.cjs"
  },
  "build": {
    "appId": "dev.envvault.desktop",
    "productName": "EnvVault",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "*.cjs",
      "!*.test.cjs",
      "index.html",
      "styles.css",
      "operations.js",
      "renderer.js",
      "icon.svg",
      "package.json",
      "!release/**"
    ],
    "extraResources": [
      {
        "from": "../dist/cli.js",
        "to": "cli/cli.js"
      },
      {
        "from": "cli-package.json",
        "to": "cli/package.json"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon.svg"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.56.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/igu1/envvault.git",
    "directory": "frontend"
  }
}
